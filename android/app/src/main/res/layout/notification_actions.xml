<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:baselineAligned="false">
    <TextView android:id="@+id/send" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="@string/action_send_copied"
        android:textSize="14sp" android:textColor="@color/notification_action"
        android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/receive" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="@string/action_get_from_pc"
        android:textSize="14sp" android:textColor="@color/notification_action"
        android:background="?android:attr/selectableItemBackground" />
    <TextView android:id="@+id/attach" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="@string/action_send_file"
        android:textSize="14sp" android:textColor="@color/notification_action"
        android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
