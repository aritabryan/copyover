<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:baselineAligned="false" android:padding="4dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/send" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_up"
            android:tint="@color/widget_content" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="@string/action_send_copied"
            android:textSize="12sp" android:textColor="@color/widget_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/receive" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_down"
            android:tint="@color/widget_content" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="@string/action_get_from_pc"
            android:textSize="12sp" android:textColor="@color/widget_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/attach" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="vertical"
        android:background="?android:attr/selectableItemBackground" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_attach"
            android:tint="@color/widget_content" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="@string/action_send_file"
            android:textSize="12sp" android:textColor="@color/widget_content" />
    </LinearLayout>
</LinearLayout>
