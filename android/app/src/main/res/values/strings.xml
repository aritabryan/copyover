    <string name="help">Help</string>
    <string name="help_clipboard">Copy text or an image in Windows, then paste it on your phone. To copy the other way, start Shizuku or tap Send copied.</string>
    <string name="help_history">Tap a copy to see it in full. The pin keeps it; the trash button clears recent copies. History keeps up to 100 copies for 7 days and 20 pinned items. Very long texts are not saved.</string>
    <string name="help_updates">Keep CopyOver open on your PC and tap Check for updates on your phone.</string>
    <string name="help_clipboard_title">Copy and paste</string>
    <string name="help_history_title">History</string>
    <string name="help_files_title">Photos and documents</string>
    <string name="help_files">Send file opens your photos and documents. Receive PC files in Files. No fixed size cap: both devices need free space. If Wi-Fi drops, it tries to continue where it stopped.</string>
    <string name="help_updates_title">Updates</string>
    <string name="setting_help_label">What this does: %1$s</string>
    <string name="auto_receive_info">Puts text and images copied in Windows on your phone clipboard. Documents and videos are not downloaded automatically. To try it, copy new text on your PC and paste it in another app on your phone.</string>
    <string name="auto_send_info">Sends text and images copied on your phone to your PC. Shizuku must be running and authorized. You can keep your current keyboard.</string>
    <string name="file_alerts_info">Checks for files your PC has made available to this phone and notifies you. Tap the notification to accept them in Files. They are not downloaded automatically.</string>
